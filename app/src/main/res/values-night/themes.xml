<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CronicasDelApetito" parent="android:Theme.Material.NoActionBar">
        <!--
          De noche los iconos de la barra de estado
          pasan a claros; la barra es transparente y detrás se ve el fondo
          de la propia app.
        -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Los selectores de fecha y hora son diálogos del sistema. -->
        <item name="android:colorAccent">#C9D1D9</item>
        <item name="android:colorPrimary">#C9D1D9</item>
        <item name="android:colorControlActivated">#C9D1D9</item>
        <item name="android:textColorPrimary">#E6E8EA</item>
        <item name="android:colorBackground">#121416</item>
    </style>
</resources>
