<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CronicasDelApetito" parent="android:Theme.Material.NoActionBar">
        <!--
          De noche los iconos de la barra de estado
          pasan a claros; la barra es transparente y detrás se ve el fondo
          de la propia app.
        -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Los selectores de fecha y hora son diálogos del sistema. -->
        <item name="android:colorAccent">#D9A574</item>
        <item name="android:colorPrimary">#D9A574</item>
        <item name="android:colorControlActivated">#D9A574</item>
        <item name="android:textColorPrimary">#F0E7DC</item>
        <item name="android:colorBackground">#1A1512</item>
    </style>
</resources>
